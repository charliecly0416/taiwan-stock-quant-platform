{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nmrpa.real_trust_one_shot_authorization.synthetic.v1",
  "title": "NMRPA3 T_R-A synthetic one-shot authorization placeholder",
  "type": "object",
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "required": [
    "schema_version", "authorization_id", "target_placeholder", "authorization_state",
    "ordered_root_refs", "required_log_heads", "contract_digests", "allowed_output_root",
    "external_input_anchor_locator", "event_anchor_locator", "issued_at", "not_before",
    "expires_at", "max_consumptions", "consumption_count", "terminal",
    "allow_payload_read", "capabilities", "issuer_proof", "authorization_sha256"
  ],
  "properties": {
    "schema_version": {"const": "nmrpa.real_trust_one_shot_authorization.synthetic.v1"},
    "authorization_id": {"type": "string", "pattern": "^synthetic_[a-z0-9_.-]+$"},
    "target_placeholder": {"const": "__NMRPA_EXACT_SINGLE_TARGET_NOT_BOUND__"},
    "authorization_state": {"const": "reserved"},
    "ordered_root_refs": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "prefixItems": [
        {"$ref": "#/$defs/sealed_calendar"}, {"$ref": "#/$defs/formal_instruments"},
        {"$ref": "#/$defs/adjusted_price"}, {"$ref": "#/$defs/twii"},
        {"$ref": "#/$defs/modela_signal"}
      ],
      "items": false
    },
    "required_log_heads": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "prefixItems": [
        {"$ref": "#/$defs/principal_head"}, {"$ref": "#/$defs/identity_head"},
        {"$ref": "#/$defs/credential_head"}, {"$ref": "#/$defs/service_head"},
        {"$ref": "#/$defs/authority_head"}, {"$ref": "#/$defs/recorder_head"}
      ],
      "items": false
    },
    "contract_digests": {
      "type": "object", "additionalProperties": false, "unevaluatedProperties": false,
      "required": ["feature_contract_sha256", "target_contract_sha256", "split_contract_sha256", "decision_time_policy_sha256"],
      "properties": {
        "feature_contract_sha256": {"$ref": "#/$defs/sha"},
        "target_contract_sha256": {"$ref": "#/$defs/sha"},
        "split_contract_sha256": {"$ref": "#/$defs/sha"},
        "decision_time_policy_sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "allowed_output_root": {"const": "SYNTHETIC_TMP_ONLY/nmrpa/no_output"},
    "external_input_anchor_locator": {"const": "synthetic://external-input-anchor/not-bound"},
    "event_anchor_locator": {"const": "synthetic://event-anchor/not-bound"},
    "issued_at": {"type": "string", "format": "date-time", "pattern": "^2099-"},
    "not_before": {"type": "string", "format": "date-time", "pattern": "^2099-"},
    "expires_at": {"type": "string", "format": "date-time", "pattern": "^2099-"},
    "max_consumptions": {"const": 1}, "consumption_count": {"const": 0}, "terminal": {"const": false},
    "allow_payload_read": {
      "type": "object", "additionalProperties": false, "unevaluatedProperties": false,
      "required": ["allowed", "root_kinds", "sealed_only", "max_roots"],
      "properties": {
        "allowed": {"const": true},
        "root_kinds": {"const": ["sealed_calendar", "formal_instruments", "adjusted_price", "twii", "modela_signal"]},
        "sealed_only": {"const": true}, "max_roots": {"const": 5}
      }
    },
    "capabilities": {
      "type": "object", "additionalProperties": false, "unevaluatedProperties": false,
      "required": ["binding", "candidate", "event", "metric", "training", "publish", "network", "database"],
      "properties": {
        "binding": {"const": false}, "candidate": {"const": false}, "event": {"const": false},
        "metric": {"const": false}, "training": {"const": false}, "publish": {"const": false},
        "network": {"const": false}, "database": {"const": false}
      }
    },
    "issuer_proof": {
      "type": "object", "additionalProperties": false, "unevaluatedProperties": false,
      "required": ["proof_mode", "issuer_principal_id", "issuer_identity_id", "issuer_credential_id", "issuer_role", "credential_status", "credential_transition_sha256", "issuer_registry_head_sha256", "commit_proof_sha256"],
      "properties": {
        "proof_mode": {"const": "synthetic_unissued_fixture"},
        "issuer_principal_id": {"type": "string", "pattern": "^synthetic_[a-z0-9_.-]+$"},
        "issuer_identity_id": {"type": "string", "pattern": "^synthetic_[a-z0-9_.-]+$"},
        "issuer_credential_id": {"type": "string", "pattern": "^synthetic_[a-z0-9_.-]+$"},
        "issuer_role": {"const": "trust_registry_issuer"}, "credential_status": {"const": "active"},
        "credential_transition_sha256": {"$ref": "#/$defs/sha"},
        "issuer_registry_head_sha256": {"$ref": "#/$defs/sha"},
        "commit_proof_sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "authorization_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "root_ref": {
      "type": "object", "additionalProperties": false, "unevaluatedProperties": false,
      "required": ["order", "root_kind", "root_id", "locator_token", "reservation_status"],
      "properties": {"order": {"type": "integer"}, "root_kind": {"type": "string"}, "root_id": {"type": "string"}, "locator_token": {"type": "string"}, "reservation_status": {"const": "reserved_empty"}}
    },
    "sealed_calendar": {"allOf": [{"$ref": "#/$defs/root_ref"}, {"properties": {"order": {"const": 1}, "root_kind": {"const": "sealed_calendar"}, "root_id": {"const": "nmrpa_sealed_calendar_root_v1"}, "locator_token": {"const": "NMRPA_REAL_ROOT_SEALED_CALENDAR_V1"}}}]},
    "formal_instruments": {"allOf": [{"$ref": "#/$defs/root_ref"}, {"properties": {"order": {"const": 2}, "root_kind": {"const": "formal_instruments"}, "root_id": {"const": "nmrpa_formal_instruments_root_v1"}, "locator_token": {"const": "NMRPA_REAL_ROOT_FORMAL_INSTRUMENTS_V1"}}}]},
    "adjusted_price": {"allOf": [{"$ref": "#/$defs/root_ref"}, {"properties": {"order": {"const": 3}, "root_kind": {"const": "adjusted_price"}, "root_id": {"const": "nmrpa_adjusted_price_root_v1"}, "locator_token": {"const": "NMRPA_REAL_ROOT_ADJUSTED_PRICE_V1"}}}]},
    "twii": {"allOf": [{"$ref": "#/$defs/root_ref"}, {"properties": {"order": {"const": 4}, "root_kind": {"const": "twii"}, "root_id": {"const": "nmrpa_twii_root_v1"}, "locator_token": {"const": "NMRPA_REAL_ROOT_TWII_V1"}}}]},
    "modela_signal": {"allOf": [{"$ref": "#/$defs/root_ref"}, {"properties": {"order": {"const": 5}, "root_kind": {"const": "modela_signal"}, "root_id": {"const": "nmrpa_modela_signal_root_v1"}, "locator_token": {"const": "NMRPA_REAL_ROOT_MODELA_SIGNAL_V1"}}}]},
    "head_ref": {
      "type": "object", "additionalProperties": false, "unevaluatedProperties": false,
      "required": ["bootstrap_order", "logical_name", "log_id", "head_sha256"],
      "properties": {"bootstrap_order": {"type": "integer"}, "logical_name": {"type": "string"}, "log_id": {"type": "string"}, "head_sha256": {"$ref": "#/$defs/sha"}}
    },
    "principal_head": {"allOf": [{"$ref": "#/$defs/head_ref"}, {"properties": {"bootstrap_order": {"const": 1}, "logical_name": {"const": "principal_registry_log"}, "log_id": {"const": "nmrpa.principal_registry.v1"}}}]},
    "identity_head": {"allOf": [{"$ref": "#/$defs/head_ref"}, {"properties": {"bootstrap_order": {"const": 2}, "logical_name": {"const": "identity_registry_log"}, "log_id": {"const": "nmrpa.identity_registry.v1"}}}]},
    "credential_head": {"allOf": [{"$ref": "#/$defs/head_ref"}, {"properties": {"bootstrap_order": {"const": 3}, "logical_name": {"const": "credential_registry_log"}, "log_id": {"const": "nmrpa.credential_registry.v1"}}}]},
    "service_head": {"allOf": [{"$ref": "#/$defs/head_ref"}, {"properties": {"bootstrap_order": {"const": 4}, "logical_name": {"const": "trusted_service_registration_log"}, "log_id": {"const": "nmrpa.trusted_service_registration.v1"}}}]},
    "authority_head": {"allOf": [{"$ref": "#/$defs/head_ref"}, {"properties": {"bootstrap_order": {"const": 5}, "logical_name": {"const": "publication_authority_registration_log"}, "log_id": {"const": "nmrpa.publication_authority_registration.v1"}}}]},
    "recorder_head": {"allOf": [{"$ref": "#/$defs/head_ref"}, {"properties": {"bootstrap_order": {"const": 6}, "logical_name": {"const": "capture_recorder_registration_log"}, "log_id": {"const": "nmrpa.capture_recorder_registration.v1"}}}]}
  }
}
