{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nmrpa.real_trust_bootstrap.v1",
  "title": "NMRPA3 T_R-A caller-pinned real trust bootstrap descriptor",
  "type": "object",
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "required": [
    "schema_version", "bootstrap_id", "mode", "runtime_overrides",
    "root_reservations", "fixed_logs", "trust_stores", "capabilities",
    "descriptor_sha256"
  ],
  "properties": {
    "schema_version": {"const": "nmrpa.real_trust_bootstrap.v1"},
    "bootstrap_id": {"const": "nmrpa.real_trust.bootstrap.v1"},
    "mode": {"const": "descriptor_only_no_payload_read"},
    "runtime_overrides": {"type": "object", "maxProperties": 0},
    "root_reservations": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "prefixItems": [
        {"$ref": "#/$defs/root_sealed_calendar"}, {"$ref": "#/$defs/root_formal_instruments"},
        {"$ref": "#/$defs/root_adjusted_price"}, {"$ref": "#/$defs/root_twii"},
