      ],
      "items": false
    },
    "fixed_logs": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "prefixItems": [
        {"$ref": "#/$defs/log_principal"}, {"$ref": "#/$defs/log_identity"},
        {"$ref": "#/$defs/log_credential"}, {"$ref": "#/$defs/log_service"},
        {"$ref": "#/$defs/log_authority"}, {"$ref": "#/$defs/log_recorder"}
      ],
      "items": false
