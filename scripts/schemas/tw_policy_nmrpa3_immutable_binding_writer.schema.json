{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nmrpa.immutable_binding_writer.synthetic.v1",
  "title": "NMRPA3 synthetic immutable binding intent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_kind", "schema_version", "mode", "transaction_id", "binding_id",
    "target_asof", "available_at", "descriptor_sha256", "log_ref",
    "expected_previous_head", "authorization", "ordered_bindings", "issuer",
    "signature", "prepared_at", "committed_at", "intent_sha256"
  ],
  "properties": {
    "artifact_kind": {"const": "binding_intent"},
    "schema_version": {"const": "nmrpa.immutable_binding_intent.synthetic.v1"},
    "mode": {"const": "synthetic_metadata_only_no_payload_read"},
    "transaction_id": {"type": "string", "pattern": "^txn_synthetic_[a-z0-9._-]{8,96}$"},
    "binding_id": {"type": "string", "pattern": "^synthetic_[a-z0-9_.-]{2,117}$"},
    "target_asof": {"type": "string", "format": "date"},
    "available_at": {"$ref": "#/$defs/time"},
    "descriptor_sha256": {"$ref": "#/$defs/sha"},
    "log_ref": {"$ref": "#/$defs/logRef"},
    "expected_previous_head": {
      "oneOf": [
        {"$ref": "#/$defs/genesisHead"},
        {"$ref": "#/$defs/committedHead"}
      ]
    },
    "authorization": {"$ref": "#/$defs/authorization"},
    "ordered_bindings": {
      "type": "array",
      "prefixItems": [
        {"$ref": "#/$defs/sealedCalendar"},
        {"$ref": "#/$defs/formalInstruments"},
        {"$ref": "#/$defs/adjustedPrice"},
        {"$ref": "#/$defs/twii"},
        {"$ref": "#/$defs/modelaSignal"}
      ],
      "items": false,
      "minItems": 5,
      "maxItems": 5
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer_identity_id", "issuer_credential_id", "payload_schema_id"],
      "properties": {
        "issuer_identity_id": {"type": "string", "pattern": "^synthetic_[a-z0-9_.-]{2,117}$"},
        "issuer_credential_id": {"type": "string", "pattern": "^synthetic_[a-z0-9_.-]{2,117}$"},
        "payload_schema_id": {"type": "string", "pattern": "^synthetic_[a-z0-9_.-]{2,117}$"}
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "credential_id", "signed_digest", "signature_base64"],
      "properties": {
        "algorithm": {"const": "ed25519"},
        "credential_id": {"type": "string", "pattern": "^synthetic_[a-z0-9_.-]{2,117}$"},
        "signed_digest": {"$ref": "#/$defs/sha"},
        "signature_base64": {"type": "string", "pattern": "^(?:[A-Za-z0-9+/]{4}){21}[A-Za-z0-9+/]{2}==$", "contentEncoding": "base64"}
      }
    },
    "prepared_at": {"$ref": "#/$defs/time"},
    "committed_at": {"$ref": "#/$defs/time"},
    "intent_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "logRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bootstrap_order", "logical_name", "log_kind", "log_id", "head_locator", "history_locator", "journal_locator", "commit_marker_locator"],
      "properties": {
        "bootstrap_order": {}, "logical_name": {}, "log_kind": {}, "log_id": {},
        "head_locator": {}, "history_locator": {}, "journal_locator": {}, "commit_marker_locator": {}
      },
      "oneOf": [
        {"$ref": "#/$defs/logRefPrincipal"}, {"$ref": "#/$defs/logRefIdentity"},
        {"$ref": "#/$defs/logRefCredential"}, {"$ref": "#/$defs/logRefTrustedService"},
        {"$ref": "#/$defs/logRefPublicationAuthority"}, {"$ref": "#/$defs/logRefCaptureRecorder"}
      ]
    },
    "logRefPrincipal": {"properties": {"bootstrap_order": {"const": 1}, "logical_name": {"const": "principal_registry_log"}, "log_kind": {"const": "issuer_registry"}, "log_id": {"const": "nmrpa.principal_registry.v1"}, "head_locator": {"const": "data_tw/artifacts/research/nmrpa/trust_bootstrap_v1/fixed_logs/principal_registry_log/head.json"}, "history_locator": {"const": "data_tw/artifacts/research/nmrpa/trust_bootstrap_v1/fixed_logs/principal_registry_log/historical_heads.json"}, "journal_locator": {"const": "data_tw/artifacts/research/nmrpa/trust_bootstrap_v1/fixed_logs/principal_registry_log/journals"}, "commit_marker_locator": {"const": "data_tw/artifacts/research/nmrpa/trust_bootstrap_v1/fixed_logs/principal_registry_log/commit_markers"}}},
    "logRefIdentity": {"properties": {"bootstrap_order": {"const": 2}, "logical_name": {"const": "identity_registry_log"}, "log_kind": {"const": "issuer_registry"}, "log_id": {"const": "nmrpa.identity_registry.v1"}, "head_locator": {"const": "data_tw/artifacts/research/nmrpa/trust_bootstrap_v1/fixed_logs/identity_registry_log/head.json"}, "history_locator": {"const": "data_tw/artifacts/research/nmrpa/trust_bootstrap_v1/fixed_logs/identity_registry_log/historical_heads.json"}, "journal_locator": {"const": "data_tw/artifacts/research/nmrpa/trust_bootstrap_v1/fixed_logs/identity_registry_log/journals"}, "commit_marker_locator": {"const": "data_tw/artifacts/research/nmrpa/trust_bootstrap_v1/fixed_logs/identity_registry_log/commit_markers"}}},
    "logRefCredential": {"properties": {"bootstrap_order": {"const": 3}, "logical_name": {"const": "credential_registry_log"}, "log_kind": {"const": "issuer_registry"}, "log_id": {"const": "nmrpa.credential_registry.v1"}, "head_locator": {"const": "data_tw/artifacts/research/nmrpa/trust_bootstrap_v1/fixed_logs/credential_registry_log/head.json"}, "history_locator": {"const": "data_tw/artifacts/research/nmrpa/trust_bootstrap_v1/fixed_logs/credential_registry_log/historical_heads.json"}, "journal_locator": {"const": "data_tw/artifacts/research/nmrpa/trust_bootstrap_v1/fixed_logs/credential_registry_log/journals"}, "commit_marker_locator": {"const": "data_tw/artifacts/research/nmrpa/trust_bootstrap_v1/fixed_logs/credential_registry_log/commit_markers"}}},
    "logRefTrustedService": {"properties": {"bootstrap_order": {"const": 4}, "logical_name": {"const": "trusted_service_registration_log"}, "log_kind": {"const": "issuer_registry"}, "log_id": {"const": "nmrpa.trusted_service_registration.v1"}, "head_locator": {"const": "data_tw/artifacts/research/nmrpa/trust_bootstrap_v1/fixed_logs/trusted_service_registration_log/head.json"}, "history_locator": {"const": "data_tw/artifacts/research/nmrpa/trust_bootstrap_v1/fixed_logs/trusted_service_registration_log/historical_heads.json"}, "journal_locator": {"const": "data_tw/artifacts/research/nmrpa/trust_bootstrap_v1/fixed_logs/trusted_service_registration_log/journals"}, "commit_marker_locator": {"const": "data_tw/artifacts/research/nmrpa/trust_bootstrap_v1/fixed_logs/trusted_service_registration_log/commit_markers"}}},
    "logRefPublicationAuthority": {"properties": {"bootstrap_order": {"const": 5}, "logical_name": {"const": "publication_authority_registration_log"}, "log_kind": {"const": "publication_authority_registry"}, "log_id": {"const": "nmrpa.publication_authority_registration.v1"}, "head_locator": {"const": "data_tw/artifacts/research/nmrpa/trust_bootstrap_v1/fixed_logs/publication_authority_registration_log/head.json"}, "history_locator": {"const": "data_tw/artifacts/research/nmrpa/trust_bootstrap_v1/fixed_logs/publication_authority_registration_log/historical_heads.json"}, "journal_locator": {"const": "data_tw/artifacts/research/nmrpa/trust_bootstrap_v1/fixed_logs/publication_authority_registration_log/journals"}, "commit_marker_locator": {"const": "data_tw/artifacts/research/nmrpa/trust_bootstrap_v1/fixed_logs/publication_authority_registration_log/commit_markers"}}},
    "logRefCaptureRecorder": {"properties": {"bootstrap_order": {"const": 6}, "logical_name": {"const": "capture_recorder_registration_log"}, "log_kind": {"const": "capture_recorder_registry"}, "log_id": {"const": "nmrpa.capture_recorder_registration.v1"}, "head_locator": {"const": "data_tw/artifacts/research/nmrpa/trust_bootstrap_v1/fixed_logs/capture_recorder_registration_log/head.json"}, "history_locator": {"const": "data_tw/artifacts/research/nmrpa/trust_bootstrap_v1/fixed_logs/capture_recorder_registration_log/historical_heads.json"}, "journal_locator": {"const": "data_tw/artifacts/research/nmrpa/trust_bootstrap_v1/fixed_logs/capture_recorder_registration_log/journals"}, "commit_marker_locator": {"const": "data_tw/artifacts/research/nmrpa/trust_bootstrap_v1/fixed_logs/capture_recorder_registration_log/commit_markers"}}},
    "genesisHead": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "logical_name", "log_id", "sequence", "previous_head_sha256", "record_sha256", "head_sha256"],
      "properties": {
        "schema_version": {"const": "nmrpa.log_head.v1"}, "logical_name": {"type": "string"},
        "log_id": {"type": "string"}, "sequence": {"const": 0}, "previous_head_sha256": {"type": "null"},
        "record_sha256": {"$ref": "#/$defs/sha"}, "head_sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "committedHead": {
      "type": "object", "additionalProperties": false,
      "allOf": [{"$ref": "#/$defs/logHeadIdentity"}],
      "required": ["schema_version", "log_kind", "log_id", "sequence", "transaction_id", "previous_head_sha256", "commit_sha256", "committed_at", "head_sha256"],
      "properties": {
        "schema_version": {"const": "nmrpa.committed_head.v1"}, "log_kind": {"type": "string"}, "log_id": {"type": "string"},
        "sequence": {"type": "integer", "minimum": 1}, "transaction_id": {"type": "string", "pattern": "^txn_synthetic_[a-z0-9._-]{8,96}$"},
        "previous_head_sha256": {"$ref": "#/$defs/sha"}, "commit_sha256": {"$ref": "#/$defs/sha"},
        "committed_at": {"$ref": "#/$defs/time"}, "head_sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "logHeadIdentity": {
      "oneOf": [
        {"properties": {"log_kind": {"const": "issuer_registry"}, "log_id": {"const": "nmrpa.principal_registry.v1"}}},
        {"properties": {"log_kind": {"const": "issuer_registry"}, "log_id": {"const": "nmrpa.identity_registry.v1"}}},
        {"properties": {"log_kind": {"const": "issuer_registry"}, "log_id": {"const": "nmrpa.credential_registry.v1"}}},
        {"properties": {"log_kind": {"const": "issuer_registry"}, "log_id": {"const": "nmrpa.trusted_service_registration.v1"}}},
        {"properties": {"log_kind": {"const": "publication_authority_registry"}, "log_id": {"const": "nmrpa.publication_authority_registration.v1"}}},
        {"properties": {"log_kind": {"const": "capture_recorder_registry"}, "log_id": {"const": "nmrpa.capture_recorder_registration.v1"}}}
      ]
    },
    "authorization": {
      "type": "object", "additionalProperties": false,
      "required": ["authorization_id", "authorization_sha256", "allowed_binding_id", "allowed_target_asof", "expected_previous_head_sha256", "max_consumptions", "consumption_count", "terminal"],
      "properties": {
        "authorization_id": {"type": "string", "pattern": "^synthetic_[a-z0-9_.-]{2,117}$"},
        "authorization_sha256": {"$ref": "#/$defs/sha"}, "allowed_binding_id": {"type": "string", "pattern": "^synthetic_[a-z0-9_.-]{2,117}$"},
        "allowed_target_asof": {"type": "string", "format": "date"}, "expected_previous_head_sha256": {"$ref": "#/$defs/sha"},
        "max_consumptions": {"const": 1}, "consumption_count": {"const": 0}, "terminal": {"const": false}
      }
    },
    "schemaIdentity": {
      "type": "object", "additionalProperties": false, "required": ["schema_id", "schema_sha256"],
      "properties": {"schema_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$"}, "schema_sha256": {"$ref": "#/$defs/sha"}}
    },
    "externalAnchor": {
      "type": "object", "additionalProperties": false, "required": ["anchor_id", "anchor_sha256", "anchored_at"],
      "properties": {"anchor_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$"}, "anchor_sha256": {"$ref": "#/$defs/sha"}, "anchored_at": {"$ref": "#/$defs/time"}}
    },
    "bindingBase": {
      "type": "object",
      "required": ["order", "root_ref", "payload_sha256", "payload_size", "media_type", "schema_identity", "external_anchor"],
      "properties": {
        "order": {"type": "integer"}, "root_ref": {"type": "object"}, "payload_sha256": {"$ref": "#/$defs/sha"},
        "payload_size": {"type": "integer", "minimum": 1}, "media_type": {"type": "string", "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"},
        "schema_identity": {"$ref": "#/$defs/schemaIdentity"}, "external_anchor": {"$ref": "#/$defs/externalAnchor"}
      }
    },
    "rootRef1": {"$ref": "#/$defs/rootRefSealedCalendar"},
    "rootRef2": {"$ref": "#/$defs/rootRefFormalInstruments"},
    "rootRef3": {"$ref": "#/$defs/rootRefAdjustedPrice"},
    "rootRef4": {"$ref": "#/$defs/rootRefTwii"},
    "rootRef5": {"$ref": "#/$defs/rootRefModelaSignal"},
    "rootRefSealedCalendar": {
      "type": "object", "additionalProperties": false,
      "required": ["root_kind", "root_id", "base_id", "root_project_relative_path", "locator_token"],
      "properties": {
        "root_kind": {"const": "sealed_calendar"}, "root_id": {"const": "nmrpa_sealed_calendar_root_v1"},
        "base_id": {"const": "nmrpa_isolated_source_base_v1"},
        "root_project_relative_path": {"const": "data_tw/artifacts/research/nmrpa/immutable_source_roots/sealed_calendar/nmrpa_sealed_calendar_root_v1"},
        "locator_token": {"const": "NMRPA_REAL_ROOT_SEALED_CALENDAR_V1"}
      }
    },
    "rootRefFormalInstruments": {
      "type": "object", "additionalProperties": false,
      "required": ["root_kind", "root_id", "base_id", "root_project_relative_path", "locator_token"],
      "properties": {
        "root_kind": {"const": "formal_instruments"}, "root_id": {"const": "nmrpa_formal_instruments_root_v1"},
        "base_id": {"const": "nmrpa_isolated_source_base_v1"},
        "root_project_relative_path": {"const": "data_tw/artifacts/research/nmrpa/immutable_source_roots/formal_instruments/nmrpa_formal_instruments_root_v1"},
        "locator_token": {"const": "NMRPA_REAL_ROOT_FORMAL_INSTRUMENTS_V1"}
      }
    },
    "rootRefAdjustedPrice": {
      "type": "object", "additionalProperties": false,
      "required": ["root_kind", "root_id", "base_id", "root_project_relative_path", "locator_token"],
      "properties": {
        "root_kind": {"const": "adjusted_price"}, "root_id": {"const": "nmrpa_adjusted_price_root_v1"},
        "base_id": {"const": "nmrpa_isolated_source_base_v1"},
        "root_project_relative_path": {"const": "data_tw/artifacts/research/nmrpa/immutable_source_roots/adjusted_price/nmrpa_adjusted_price_root_v1"},
        "locator_token": {"const": "NMRPA_REAL_ROOT_ADJUSTED_PRICE_V1"}
      }
    },
    "rootRefTwii": {
      "type": "object", "additionalProperties": false,
      "required": ["root_kind", "root_id", "base_id", "root_project_relative_path", "locator_token"],
      "properties": {
        "root_kind": {"const": "twii"}, "root_id": {"const": "nmrpa_twii_root_v1"},
        "base_id": {"const": "nmrpa_isolated_source_base_v1"},
        "root_project_relative_path": {"const": "data_tw/artifacts/research/nmrpa/immutable_source_roots/twii/nmrpa_twii_root_v1"},
        "locator_token": {"const": "NMRPA_REAL_ROOT_TWII_V1"}
      }
    },
    "rootRefModelaSignal": {
      "type": "object", "additionalProperties": false,
      "required": ["root_kind", "root_id", "base_id", "root_project_relative_path", "locator_token"],
      "properties": {
        "root_kind": {"const": "modela_signal"}, "root_id": {"const": "nmrpa_modela_signal_root_v1"},
        "base_id": {"const": "nmrpa_isolated_source_base_v1"},
        "root_project_relative_path": {"const": "data_tw/artifacts/research/nmrpa/immutable_source_roots/modela_signal/nmrpa_modela_signal_root_v1"},
        "locator_token": {"const": "NMRPA_REAL_ROOT_MODELA_SIGNAL_V1"}
      }
    },
    "sealedCalendar": {"allOf": [{"$ref": "#/$defs/bindingBase"}, {"type": "object", "properties": {"order": {"const": 1}, "root_ref": {"$ref": "#/$defs/rootRef1"}}}], "unevaluatedProperties": false},
    "formalInstruments": {"allOf": [{"$ref": "#/$defs/bindingBase"}, {"type": "object", "properties": {"order": {"const": 2}, "root_ref": {"$ref": "#/$defs/rootRef2"}}}], "unevaluatedProperties": false},
    "adjustedPrice": {"allOf": [{"$ref": "#/$defs/bindingBase"}, {"type": "object", "properties": {"order": {"const": 3}, "root_ref": {"$ref": "#/$defs/rootRef3"}}}], "unevaluatedProperties": false},
    "twii": {"allOf": [{"$ref": "#/$defs/bindingBase"}, {"type": "object", "properties": {"order": {"const": 4}, "root_ref": {"$ref": "#/$defs/rootRef4"}}}], "unevaluatedProperties": false},
    "modelaSignal": {"allOf": [{"$ref": "#/$defs/bindingBase"}, {"type": "object", "properties": {"order": {"const": 5}, "root_ref": {"$ref": "#/$defs/rootRef5"}}}], "unevaluatedProperties": false}
  },
  "x-runtime-exact-constraints": {
    "ordered_root_tuple": ["sealed_calendar", "formal_instruments", "adjusted_price", "twii", "modela_signal"],
    "descriptor_and_locator_values": "const-equal to frozen bootstrap descriptor",
    "python_exact_types": true,
    "unknown_fields": "rejected recursively",
    "payload_path_bytes_handle": "forbidden",
    "actual_project_root_commit": "forbidden"
  }
}
