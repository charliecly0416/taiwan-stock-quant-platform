{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tw_policy_nmrpa3_optional_source_binding_plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_kind",
    "schema_version",
    "mode",
    "transaction_id",
    "binding_id",
    "authorization_id",
    "descriptor_sha256",
    "expected_previous_head",
    "request_scope",
    "response_evidence",
    "binding_record",
    "anchor_record",
    "signed_record",
    "journal",
    "commit_marker",
    "new_head",
    "paths",
    "staging_paths",
    "commit_order",
    "plan_sha256"
