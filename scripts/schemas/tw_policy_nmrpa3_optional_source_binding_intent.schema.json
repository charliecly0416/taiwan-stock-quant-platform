  "properties": {
    "artifact_kind": {
      "const": "optional_source_binding_intent"
    },
    "schema_version": {
      "const": "nmrpa.optional_source_binding_intent.synthetic.v1"
    },
    "mode": {
      "const": "synthetic_metadata_only_no_payload_read"
    },
    "transaction_id": {
      "type": "string",
      "pattern": "^txn_synthetic_[a-z0-9._-]{8,96}$"
