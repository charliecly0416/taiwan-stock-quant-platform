        "sealed_response_object_id": {
          "type": "string",
          "pattern": "^synthetic_"
        },
        "sealed_response_raw_sha256": {
          "$ref": "#/$defs/sha"
        },
        "normalized_inventory_sha256": {
          "$ref": "#/$defs/sha"
        },
        "payload_sha256": {
          "$ref": "#/$defs/sha"
        },
        "payload_byte_size": {"$ref":"#/$defs/canonicalUint"},
        "returned_instrument_count": {"type":"string","pattern":"^(0|[1-9][0-9]?|1[0-4][0-9]|150)$"},
        "ordered_returned_instruments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "returned_instrument_set_sha256": {
          "$ref": "#/$defs/sha"
        },
        "ordered_absent_instruments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "absent_instrument_set_sha256": {
          "$ref": "#/$defs/sha"
        },
        "capture_attempt_chain_sha256": {
          "$ref": "#/$defs/sha"
        },
        "trusted_time_evidence_ref": {
          "$ref": "#/$defs/simpleRef"
        },
        "issuer_registration_ref": {
          "$ref": "#/$defs/ref"
        },
        "capture_recorder_registration_ref": {
          "$ref": "#/$defs/ref"
        },
        "authorization_ref": {
          "$ref": "#/$defs/ref"
        },
        "response_anchor_ref": {
          "$ref": "#/$defs/ref"
        },
        "response_evidence_sha256": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "rowInstitutional": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "source_asof",
        "available_at",
        "foreign_net_buy",
        "investment_trust_net_buy",
        "dealer_net_buy",
        "normalized_row_sha256"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "source_asof": {
          "type": "string",
          "format": "date"
        },
        "available_at": {
          "$ref": "#/$defs/time"
        },
        "foreign_net_buy": {
          "type": "number"
        },
        "investment_trust_net_buy": {
          "type": "number"
        },
        "dealer_net_buy": {
          "type": "number"
        },
        "normalized_row_sha256": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "rowMargin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "source_asof",
        "available_at",
        "margin_balance",
        "margin_balance_change",
        "short_balance",
        "short_balance_change",
        "normalized_row_sha256"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "source_asof": {
          "type": "string",
          "format": "date"
        },
        "available_at": {
          "$ref": "#/$defs/time"
        },
        "margin_balance": {
          "type": "number"
        },
        "margin_balance_change": {
          "type": "number"
        },
        "short_balance": {
          "type": "number"
        },
        "short_balance_change": {
          "type": "number"
        },
        "normalized_row_sha256": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "evidence_state",
        "source_kind",
        "instrument",
        "decision_date",
        "request_scope_ref",
        "response_evidence_ref",
        "source_asof",
        "available_at",
        "payload_inventory_sha256",
        "capture_attempt_chain_sha256",
        "trusted_time_ref",
        "issuer_ref",
        "head_ref",
        "anchor_ref",
        "instrument_evidence_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "nmrpa.optional_source_instrument_evidence.v1"
        },
        "evidence_state": {
          "enum": [
            "present",
            "confirmed_absent"
          ]
        },
        "source_kind": {
          "enum": [
            "institutional",
            "margin"
          ]
        },
        "instrument": {
          "type": "string",
          "pattern": "^TW[0-9A-Z]{4,10}$"
        },
        "decision_date": {
          "type": "string",
          "format": "date"
        },
        "request_scope_ref": {
          "$ref": "#/$defs/simpleRef"
        },
        "response_evidence_ref": {
          "$ref": "#/$defs/simpleRef"
        },
        "source_asof": {
          "type": "string",
          "format": "date"
        },
        "available_at": {
          "$ref": "#/$defs/time"
        },
        "checked_at": {
          "$ref": "#/$defs/time"
        },
        "absence_reason": {
          "const": "authoritative_complete_scope_no_rows_for_instrument"
        },
        "ordered_rows": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/rowInstitutional"
              },
              {
                "$ref": "#/$defs/rowMargin"
              }
            ]
          },
          "minItems": 10,
          "maxItems": 10
        },
        "row_key_set_sha256": {
          "$ref": "#/$defs/sha"
        },
        "normalized_row_set_sha256": {
          "$ref": "#/$defs/sha"
        },
        "returned_instrument_set_sha256": {
          "$ref": "#/$defs/sha"
        },
        "absent_instrument_set_sha256": {
          "$ref": "#/$defs/sha"
        },
        "sealed_response_raw_sha256": {
          "$ref": "#/$defs/sha"
        },
        "payload_inventory_sha256": {
          "$ref": "#/$defs/sha"
        },
        "capture_attempt_chain_sha256": {
          "$ref": "#/$defs/sha"
        },
        "trusted_time_ref": {
          "$ref": "#/$defs/simpleRef"
        },
        "issuer_ref": {
          "$ref": "#/$defs/ref"
        },
        "head_ref": {
          "$ref": "#/$defs/ref"
        },
        "anchor_ref": {
          "$ref": "#/$defs/ref"
        },
        "instrument_evidence_sha256": {
          "$ref": "#/$defs/sha"
        }
      },
      "oneOf": [
        {
          "properties": {
            "evidence_state": {"const": "present"}
          },
          "required": [
            "ordered_rows",
            "row_key_set_sha256",
            "normalized_row_set_sha256"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "checked_at"
                ]
              },
              {
                "required": [
                  "absence_reason"
                ]
              },
              {
                "required": [
                  "returned_instrument_set_sha256"
                ]
              },
              {
                "required": [
                  "absent_instrument_set_sha256"
                ]
              },
              {
                "required": [
                  "sealed_response_raw_sha256"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "evidence_state": {"const": "confirmed_absent"}
          },
          "required": [
            "checked_at",
            "absence_reason",
            "returned_instrument_set_sha256",
            "absent_instrument_set_sha256",
            "sealed_response_raw_sha256"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "ordered_rows"
                ]
              },
              {
                "required": [
                  "row_key_set_sha256"
                ]
              },
              {
                "required": [
                  "normalized_row_set_sha256"
                ]
              }
            ]
          }
        }
      ],
      "allOf": [
        {
          "if": {"properties": {"source_kind": {"const": "institutional"}, "evidence_state": {"const": "present"}}, "required": ["source_kind", "evidence_state"]},
          "then": {"properties": {"ordered_rows": {"type": "array", "items": {"$ref": "#/$defs/rowInstitutional"}}}}
        },
        {
          "if": {"properties": {"source_kind": {"const": "margin"}, "evidence_state": {"const": "present"}}, "required": ["source_kind", "evidence_state"]},
          "then": {"properties": {"ordered_rows": {"type": "array", "items": {"$ref": "#/$defs/rowMargin"}}}}
        }
      ]
    },
    "simpleCommittedRef": {"type":"object","additionalProperties":false,"required":["id","sha256"],"properties":{"id":{"type":"string","pattern":"^synthetic_"},"sha256":{"$ref":"#/$defs/sha"}}},
    "canonicalUint": {"type":"string","pattern":"^(0|[1-9][0-9]*)$"},
    "genesisHead": {"type":"object","additionalProperties":false,"required":["schema_version","log_id","sequence","previous_head_sha256","record_sha256","head_sha256"],"properties":{"schema_version":{"const":"nmrpa.optional_source.binding_log_head.v1"},"log_id":{"const":"nmrpa.optional_source_binding_log.v1"},"sequence":{"const":"0"},"previous_head_sha256":{"type":"null"},"record_sha256":{"$ref":"#/$defs/sha"},"head_sha256":{"$ref":"#/$defs/sha"}}},
    "committedHead": {"type":"object","additionalProperties":false,"required":["schema_version","log_id","sequence","transaction_id","previous_head_sha256","commit_sha256","committed_at","head_sha256"],"properties":{"schema_version":{"const":"nmrpa.optional_source.binding_log_committed_head.v1"},"log_id":{"const":"nmrpa.optional_source_binding_log.v1"},"sequence":{"type":"string","pattern":"^[1-9][0-9]*$"},"transaction_id":{"type":"string","pattern":"^txn_synthetic_"},"previous_head_sha256":{"$ref":"#/$defs/sha"},"commit_sha256":{"$ref":"#/$defs/sha"},"committed_at":{"$ref":"#/$defs/time"},"head_sha256":{"$ref":"#/$defs/sha"}}},
    "head": {"oneOf":[{"$ref":"#/$defs/genesisHead"},{"$ref":"#/$defs/committedHead"}]},
    "captureAttempt": {
      "type":"object","additionalProperties":false,
      "required":["schema_version","capture_run_id","attempt_id","source_kind","request_scope_id","request_scope_sha256","sequence","request_identity_sha256","started_at","completed_at","result_class","http_status_or_null","sealed_response_object_id_or_null","sealed_response_raw_sha256_or_null","issuer_registration_ref","capture_recorder_head_ref","attempt_sha256"],
      "properties":{"schema_version":{"const":"nmrpa.optional_source_capture_attempt.v1"},"capture_run_id":{"type":"string","pattern":"^synthetic_"},"attempt_id":{"type":"string","pattern":"^synthetic_"},"source_kind":{"enum":["institutional","margin"]},"request_scope_id":{"type":"string","pattern":"^synthetic_"},"request_scope_sha256":{"$ref":"#/$defs/sha"},"sequence":{"$ref":"#/$defs/canonicalUint"},"request_identity_sha256":{"$ref":"#/$defs/sha"},"started_at":{"$ref":"#/$defs/time"},"completed_at":{"$ref":"#/$defs/time"},"result_class":{"enum":["authoritative_success","access_failed","auth_failed","rate_limited","timeout","transport_failed","parse_failed","scope_incomplete"]},"http_status_or_null":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/canonicalUint"}]},"sealed_response_object_id_or_null":{"type":["string","null"]},"sealed_response_raw_sha256_or_null":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/sha"}]},"issuer_registration_ref":{"$ref":"#/$defs/simpleCommittedRef"},"capture_recorder_head_ref":{"$ref":"#/$defs/simpleCommittedRef"},"attempt_sha256":{"$ref":"#/$defs/sha"}}
    },
    "trustedTimeEvidence": {
      "type":"object","additionalProperties":false,
