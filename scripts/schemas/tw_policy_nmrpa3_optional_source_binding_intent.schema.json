      ],
      "properties": {
        "schema_version": {
          "const": "nmrpa.optional_source_request_scope.v1"
        },
        "profile_id": {
          "const": "nmrpa.institutional_margin.optional_daily.v1"
        },
        "request_scope_id": {
          "type": "string",
          "pattern": "^synthetic_"
        },
        "decision_date": {
          "type": "string",
          "format": "date"
        },
        "decision_time": {
          "$ref": "#/$defs/time"
        },
        "calendar_binding_id": {
          "type": "string"
        },
        "calendar_binding_sha256": {
