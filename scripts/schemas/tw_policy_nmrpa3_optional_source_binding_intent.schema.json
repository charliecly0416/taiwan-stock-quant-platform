{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tw_policy_nmrpa3_optional_source_binding_intent.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_kind",
    "schema_version",
    "mode",
    "transaction_id",
    "binding_id",
    "decision_date",
    "decision_time",
    "descriptor_sha256",
    "expected_previous_head",
    "authorization",
    "five_root_parent_binding_ref",
    "request_scope",
    "ordered_components",
    "issuer",
    "signature",
    "prepared_at",
    "committed_at",
    "intent_sha256"
