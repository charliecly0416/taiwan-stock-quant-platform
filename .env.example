# Backend
PYTHON_API_HOST=127.0.0.1
PYTHON_API_PORT=5000
FLASK_ENV=development
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/quantdinger
REDIS_URL=redis://127.0.0.1:6379/0

# Taiwan stock monitor
ENABLE_TW_STOCK_MONITOR_WORKER=false
TW_STOCK_MONITOR_USERNAME=demo
TW_STOCK_MONITOR_PASSWORD=change-me
TW_STOCK_MONITOR_ORDERS_ENABLED=false

# qlib Option C research paths
TW_STOCK_QLIB_PROVIDER_URI=./data_tw/qlib_provider
TW_STOCK_QLIB_ACCEPTED_DIR=./data_tw/accepted_latest
TW_STOCK_QLIB_NORMALIZED_DIR=./data_tw/normalized
QLIB_TW_OPTION_C_ROOT=../qlib_pipeline/data_tw/experiments/option_c_daily_signal
TW_QLIB_OPTION_C_CWD=../qlib_pipeline
TW_QLIB_OPTION_C_PROVIDER_CALENDAR=../qlib_pipeline/data_tw/experiments/yahoo_adjusted_primary/option_c_150_qlib_bin/calendars/day.txt

# OpenAI Agent, optional
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
TW_STOCK_AGENT_ENABLED=false

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:5000
VITE_ENABLE_MOCK=false
