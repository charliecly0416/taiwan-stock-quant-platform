# Backend
PYTHON_API_HOST=127.0.0.1
PYTHON_API_PORT=5000
FLASK_ENV=development
SECRET_KEY=
ADMIN_USER=demo
ADMIN_PASSWORD=
ENABLE_PENDING_ORDER_WORKER=false
ENABLE_PORTFOLIO_MONITOR=false
DISABLE_RESTORE_RUNNING_STRATEGIES=true
POSITION_SYNC_ENABLED=false
ENABLE_REFLECTION_WORKER=false
ENABLE_OFFLINE_AI_CALIBRATION=false
USDT_PAY_ENABLED=false
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/quantdinger
REDIS_URL=redis://127.0.0.1:6379/0

# Taiwan stock monitor
ENABLE_TW_STOCK_MONITOR_WORKER=false
TW_STOCK_MONITOR_USERNAME=demo
TW_STOCK_MONITOR_PASSWORD=change-me
TW_STOCK_MONITOR_ORDERS_ENABLED=false

# qlib Option C research paths
TW_STOCK_QLIB_PROVIDER_URI=./data_tw/qlib_provider
TW_STOCK_QLIB_ACCEPTED_DIR=./data_tw/accepted_latest
TW_STOCK_QLIB_NORMALIZED_DIR=./data_tw/normalized
QLIB_TW_OPTION_C_ROOT=../qlib_pipeline/data_tw/experiments/option_c_daily_signal
TW_QLIB_OPTION_C_CWD=../qlib_pipeline
TW_QLIB_OPTION_C_PROVIDER_CALENDAR=../qlib_pipeline/data_tw/experiments/yahoo_adjusted_primary/option_c_150_qlib_bin/calendars/day.txt

# OpenAI Agent, optional
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
TW_STOCK_AGENT_ENABLED=false

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:5000
VITE_ENABLE_MOCK=false

# Daily unattended Taiwan stock update
FINMIND_TOKEN=
TW_DAILY_AUTO_FINMIND_SCOPE=full
TW_DAILY_AUTO_FINMIND_LOOKBACK_DAYS=260
TW_DAILY_AUTO_SKIP_FINMIND_VALIDATE=true
TW_DAILY_AUTO_YAHOO_TIMEOUT=30
TW_DAILY_AUTO_YAHOO_RETRIES=1
TW_DAILY_AUTO_YAHOO_SLEEP_SECONDS=0.5
TW_DAILY_AUTO_MAX_WORKERS=4
TW_DAILY_AUTO_YAHOO_PROXY=
TW_DAILY_AUTO_TIMEOUT_SECONDS=1200

# Local service watchdog and backup operations
TW_STOCK_PLATFORM_ROOT=
TW_STOCK_PYTHON=
TW_STOCK_BACKEND_HOST=0.0.0.0
TW_STOCK_BACKEND_PORT=5000
TW_STOCK_FRONTEND_HOST=0.0.0.0
TW_STOCK_FRONTEND_PORT=8000
TW_STOCK_ENABLE_NGROK=false
TW_STOCK_NGROK_PORT=4040
TW_STOCK_BACKUP_ROOT=./backups/tw_stock_ops
